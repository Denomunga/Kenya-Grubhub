# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable these APIs for your project:
# - Maps JavaScript API
# - Places API
# - Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# API URL (optional - defaults to current origin)
VITE_API_URL=http://localhost:5000

# Auth0 Configuration
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# Offline POS Configuration
VITE_OFFLINE_ENCRYPTION_KEY=your-secure-encryption-key-change-this-in-production
VITE_MONGODB_SYNC_URL=http://localhost:3001/api
VITE_OFFLINE_BACKUP_INTERVAL=1800000
VITE_SYNC_INTERVAL=60000
VITE_ENABLE_OFFLINE_ANALYTICS=true

# Security
VITE_ENABLE_DATA_ENCRYPTION=true
VITE_AUTO_BACKUP_ENABLED=true
VITE_CONFLICT_RESOLUTION_STRATEGY=timestamp

# Development
VITE_OFFLINE_DEBUG=false
VITE_SYNC_DEBUG=false
